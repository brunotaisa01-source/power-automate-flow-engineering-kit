{
  "schemaVersion": "1.0",
  "profileId": "minimal-http-connector",
  "connector": "http",
  "target": {
    "resource": "{HTTP_RESOURCE}",
    "synthetic": true
  },
  "operations": [
    {
      "id": "read-record",
      "kind": "read",
      "transport": {
        "mode": "http",
        "method": "GET"
      },
      "request": {
        "allowlist": [
          "recordId"
        ],
        "required": [
          "recordId"
        ],
        "forbidden": [
          "tenantId",
          "rawUrl",
          "accessToken"
        ]
      },
      "response": {
        "successStatuses": [
          200
        ],
        "failureStatuses": [
          400,
          404,
          429,
          500,
          503
        ],
        "body": "object",
        "semanticReadback": {
          "required": false,
          "fields": [
            "recordId",
            "value"
          ]
        }
      },
      "concurrency": {
        "mode": "none",
        "tokenField": null
      },
      "retry": {
        "maxAttempts": 2,
        "retryableStatuses": [
          429,
          503
        ],
        "ambiguousMutation": "fail"
      },
      "idempotency": {
        "required": false,
        "keyFields": [
          "recordId"
        ],
        "duplicatePolicy": "no-op"
      },
      "mutationClosure": {
        "plan": false,
        "status": false,
        "audit": false,
        "readback": false
      },
      "preRead": {
        "required": false,
        "fields": []
      }
    },
    {
      "id": "update-record",
      "kind": "update",
      "transport": {
        "mode": "http",
        "method": "PATCH"
      },
      "request": {
        "allowlist": [
          "recordId",
          "value",
          "idempotencyKey",
          "version"
        ],
        "required": [
          "recordId",
          "value",
          "idempotencyKey",
          "version"
        ],
        "forbidden": [
          "tenantId",
          "rawUrl",
          "accessToken"
        ]
      },
      "response": {
        "successStatuses": [
          200,
          204
        ],
        "failureStatuses": [
          400,
          409,
          412,
          429,
          500,
          503
        ],
        "body": "object",
        "semanticReadback": {
          "required": true,
          "fields": [
            "recordId",
            "value"
          ]
        }
      },
      "concurrency": {
        "mode": "optimistic",
        "tokenField": "version"
      },
      "retry": {
        "maxAttempts": 2,
        "retryableStatuses": [
          429,
          503
        ],
        "ambiguousMutation": "reconcile"
      },
      "idempotency": {
        "required": true,
        "keyFields": [
          "idempotencyKey"
        ],
        "duplicatePolicy": "no-op"
      },
      "mutationClosure": {
        "plan": true,
        "status": true,
        "audit": true,
        "readback": true
      },
      "preRead": {
        "required": true,
        "fields": [
          "recordId",
          "value",
          "version"
        ]
      }
    }
  ],
  "evidence": {
    "claimClass": "RUNTIME_SYNTHETIC",
    "tenantRuntime": false
  },
  "connectorContract": {
    "connectionKind": "http-endpoint",
    "nativeOperations": {
      "read": "GET",
      "mutation": "PATCH"
    },
    "permission": {
      "required": true,
      "mutationRole": "http-endpoint-write",
      "readbackFields": [
        "principal",
        "role",
        "effective"
      ]
    },
    "pagination": {
      "mode": "continuation-url",
      "pageSize": 50,
      "readbackRequired": true
    },
    "payload": {
      "mode": "parameterized-http",
      "requiredFields": [
        "recordId",
        "idempotencyKey"
      ],
      "forbiddenFields": [
        "tenantId",
        "rawUrl",
        "accessToken",
        "rawQuery",
        "queryFragment"
      ]
    }
  }
}
