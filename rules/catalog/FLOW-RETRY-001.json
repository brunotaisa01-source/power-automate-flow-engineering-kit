{
  "schemaVersion": "1.0",
  "id": "FLOW-RETRY-001",
  "title": "Ambiguous mutation reconciliation",
  "domain": "power-automate",
  "severity": "error",
  "description": "Mutating action can retry an ambiguous result without GET reconciliation.",
  "rationale": "The inspected final artifact must preserve the declared offline safety contract.",
  "appliesTo": [
    {
      "kind": "definition"
    },
    {
      "kind": "zip",
      "profile": "power-platform-solution-v1"
    }
  ],
  "detector": {
    "implementation": "packages/rules/src/power-automate/retry.ts",
    "exportName": "flowRetry001",
    "input": "artifact-graph",
    "deterministic": true,
    "network": "forbidden",
    "parameters": {}
  },
  "red": {
    "root": "fixtures/rules/FLOW-RETRY-001/red",
    "expectedResult": "FAIL",
    "expectedDiagnosticCodes": [
      "FLOW-RETRY-001"
    ]
  },
  "green": {
    "root": "fixtures/rules/FLOW-RETRY-001/green",
    "expectedResult": "PASS",
    "expectedDiagnosticCodes": []
  },
  "finalArtifact": {
    "required": true,
    "artifactKinds": [
      "generated-definition",
      "zip"
    ]
  },
  "remediation": [
    "Disable implicit mutation retries and add a GET reconciliation branch for failed or timed-out writes before any contract-approved replay."
  ],
  "residualGate": {
    "required": true,
    "claimClass": "LIVE_SMOKE",
    "description": "Fault-injected tenant execution remains external."
  },
  "supportedEvidence": [
    "LOCAL_STATIC",
    "PACKAGE_ARTIFACT"
  ],
  "tags": [
    "power-automate",
    "offline",
    "synthetic"
  ]
}
