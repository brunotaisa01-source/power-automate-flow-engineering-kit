{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spflow.dev/schemas/evidence.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "claimClass",
    "subject",
    "contract",
    "artifacts",
    "execution",
    "assertions",
    "dependencies",
    "residualGates",
    "review",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "evidenceId": { "$ref": "#/$defs/identifier" },
    "claimClass": { "$ref": "#/$defs/evidenceClass" },
    "subject": { "$ref": "#/$defs/evidenceSubject" },
    "contract": { "$ref": "#/$defs/contractBinding" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceArtifact" }
    },
    "execution": { "$ref": "#/$defs/executionEvidence" },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceAssertion" },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "residualGates": {
      "type": "array",
      "items": { "$ref": "#/$defs/residualGateRecord" }
    },
    "review": { "$ref": "#/$defs/reviewRecord" },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED"] }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "bindingKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "evidenceClass": {
      "enum": [
        "LOCAL_STATIC",
        "LOCAL_RUNTIME",
        "PACKAGE_ARTIFACT",
        "IMPORTED",
        "REBOUND",
        "ENABLED",
        "LIVE_SMOKE",
        "TENANT_VERIFIED",
        "PUBLISHED"
      ]
    },
    "evidenceSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["toolkit-release", "project-artifact", "tenant-import", "tenant-flow", "tenant-application"]
        },
        "id": { "$ref": "#/$defs/identifier" },
        "targetBindingKey": { "$ref": "#/$defs/bindingKey" },
        "changeWindowId": { "$ref": "#/$defs/identifier" }
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "revision", "digest"],
      "properties": {
        "projectId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "executionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "toolVersion",
        "startedAt",
        "endedAt",
        "exitCode",
        "normalizedOutputPath",
        "networkMode"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "toolVersion": { "type": "string", "minLength": 1 },
        "startedAt": { "$ref": "#/$defs/utcTimestamp" },
        "endedAt": { "$ref": "#/$defs/utcTimestamp" },
        "exitCode": { "type": "integer" },
        "normalizedOutputPath": { "$ref": "#/$defs/repositoryPath" },
        "networkMode": { "enum": ["offline", "authenticated-read", "authorized-write"] }
      }
    },
    "evidenceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "expected", "actual", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {},
        "result": { "enum": ["PASS", "FAIL", "NOT_RUN"] }
      }
    },
    "residualGateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredClaimClass", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "requiredClaimClass": { "$ref": "#/$defs/evidenceClass" },
        "status": { "enum": ["OPEN", "SATISFIED", "NOT_APPLICABLE"] },
        "evidenceId": { "$ref": "#/$defs/identifier" }
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "reviewerRole", "decision"],
      "properties": {
        "gate": { "type": "string", "pattern": "^R[0-9]+$" },
        "reviewerRole": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["APPROVED", "REJECTED", "PENDING"] },
        "decidedAt": { "$ref": "#/$defs/utcTimestamp" }
      }
    }
  }
}
