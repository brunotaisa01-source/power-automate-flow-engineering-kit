{
  "name": "power-automate-flow-engineering-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @spflow/package-adapters && npm run build --workspace @spflow/rules && npm run build --workspace @spflow/cli",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "check": "node scripts/portable-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "5.9.3"
  }
}
